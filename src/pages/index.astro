---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PartnersCarousel from '../components/PartnersCarousel.astro';
import Pillars from '../components/Pillars.astro';
import Differential from '../components/Differential.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import OurHeadquarters from '../components/OurHeadquarters.astro';
---

<Layout 
  title="Parceria Florestal e Topografia Rural em SC e PR | SC Topografia"
  description="Avalie sua propriedade para a Parceria Florestal SC. Experiência em topografia rural, regularização fundiária, madeira e gestão de corte no Planalto Norte de SC e Sul do PR."
>
  <!-- Hero Section com Imagem de Alta Resolução, Headline e CTA -->
  <Hero />

  <!-- Carrossel de Empresas e Produtores Parceiros (Mais fluido e orgânico) -->
  <PartnersCarousel />

  <!-- Destaque dos Dois Pilares Centrais -->
  <Pillars />

  <!-- Método Exclusivo: Do Campo ao Cartório (Nosso Diferencial) -->
  <Differential />

  <!-- Cards Didáticos de Serviços (O que é e Para quem é) -->
  <ServicesGrid />

  <!-- Depoimentos e Avaliações do Google (Carrossel Interativo) -->
  <GoogleReviews />

  <!-- Nossa Sede em Rio Negrinho com Mapa Interativo -->
  <OurHeadquarters />
</Layout>
