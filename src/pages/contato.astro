---
import Layout from '../layouts/Layout.astro';
import { 
  MapPin, Phone, Mail, Clock, MessageSquare, 
  Send, ShieldCheck, ArrowRight, ExternalLink
} from 'lucide-astro';
---

<Layout 
  title="Contato & Localização | SC Topografia - Rio Negrinho - SC"
  description="Entre em contato com a SC Topografia. Atendimento presencial na Rodovia BR-280, 586, Rio Negrinho - SC, telefone fixo e WhatsApp comercial."
>
  <!-- Hero Contato -->
  <section class="relative bg-brand-dark text-white py-16 lg:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center max-w-3xl">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-900/60 border border-emerald-400/40 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-4">
        <MapPin class="w-4 h-4" />
        <span>Atendimento em Rio Negrinho e Região</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
        Fale com Nossos Especialistas
      </h1>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Venha tomar um café em nosso escritório na BR-280 ou solicite seu atendimento técnico e orçamento via WhatsApp.
      </p>
    </div>
  </section>

  <!-- Informações de Contato e Formulário -->
  <section class="py-16 lg:py-20 bg-brand-lightBg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Coluna Esquerda: Canais de Atendimento -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-8 rounded-3xl border border-gray-200/90 shadow-sm space-y-6">
            <h2 class="text-2xl font-bold text-slate-heading">Canais Diretos</h2>

            <!-- WhatsApp Comercial -->
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-emerald-50/70 border border-emerald-100">
              <div class="w-12 h-12 rounded-xl bg-brand-primary text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <MessageSquare class="w-6 h-6" />
              </div>
              <div>
                <span class="text-xs font-bold text-brand-primary uppercase tracking-wider block">WhatsApp Comercial</span>
                <a 
                  href="https://wa.me/5547984388016?text=Ol%C3%A1%21%20Gostaria%20de%20solicitar%20um%20or%C3%A7amento." 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-lg font-black text-slate-heading hover:text-brand-primary transition-colors block mt-0.5"
                >
                  (47) 98438-8016
                </a>
                <span class="text-xs text-slate-muted block mt-0.5">Resposta rápida em horário comercial</span>
              </div>
            </div>

            <!-- Telefone Fixo -->
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-brand-lightBg border border-gray-200/80">
              <div class="w-12 h-12 rounded-xl bg-slate-heading text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <Phone class="w-6 h-6" />
              </div>
              <div>
                <span class="text-xs font-bold text-slate-muted uppercase tracking-wider block">Telefone do Escritório</span>
                <a 
                  href="tel:4736444235" 
                  class="text-lg font-black text-slate-heading hover:text-brand-primary transition-colors block mt-0.5"
                >
                  (47) 3644-4235
                </a>
                <span class="text-xs text-slate-muted block mt-0.5">Atendimento recepção</span>
              </div>
            </div>

            <!-- E-mail Institucional -->
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-brand-lightBg border border-gray-200/80">
              <div class="w-12 h-12 rounded-xl bg-slate-heading text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <Mail class="w-6 h-6" />
              </div>
              <div>
                <span class="text-xs font-bold text-slate-muted uppercase tracking-wider block">E-mail Institucional</span>
                <a 
                  href="mailto:sctopoplanejamento@yahoo.com" 
                  class="text-base font-bold text-slate-heading hover:text-brand-primary transition-colors block mt-0.5 break-all"
                >
                  sctopoplanejamento@yahoo.com
                </a>
                <span class="text-xs text-slate-muted block mt-0.5">Envio de editais, plantas e propostas</span>
              </div>
            </div>

            <!-- Endereço Físico -->
            <div class="flex items-start gap-4 p-4 rounded-2xl bg-brand-lightBg border border-gray-200/80">
              <div class="w-12 h-12 rounded-xl bg-brand-dark text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <MapPin class="w-6 h-6 text-brand-accent" />
              </div>
              <div>
                <span class="text-xs font-bold text-slate-muted uppercase tracking-wider block">Nossa Sede</span>
                <p class="text-sm font-semibold text-slate-heading mt-0.5">
                  Rodovia BR-280, nº 586, Sala 05<br/>
                  Bairro Bela Vista, Rio Negrinho – SC<br/>
                  CEP: 89297-578
                </p>
                <span class="text-xs text-slate-muted block mt-1">Ao lado da rodovia, com estacionamento fácil</span>
              </div>
            </div>

            <!-- Horário de Atendimento -->
            <div class="flex items-center gap-3 text-xs text-slate-body pt-2 border-t border-gray-100">
              <Clock class="w-4 h-4 text-brand-primary" />
              <span>Segunda a Sexta-feira: das <strong>08:00 às 18:00</strong> (sem fechar para o almoço)</span>
            </div>

          </div>
        </div>

        <!-- Coluna Direita: Formulário Interativo que envia para o WhatsApp -->
        <div class="lg:col-span-7">
          <div class="bg-white p-8 sm:p-10 rounded-3xl border border-gray-200/90 shadow-sm">
            <div class="mb-8">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-brand-primary text-xs font-bold uppercase tracking-wider mb-2">
                Simulador Rápido
              </div>
              <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-heading">
                Solicite seu Orçamento Sem Compromisso
              </h2>
              <p class="text-sm text-slate-body mt-1">
                Preencha os dados abaixo para direcionarmos seu atendimento de forma personalizada.
              </p>
            </div>

            <form id="contact-form" class="space-y-5">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="nome" class="block text-xs font-bold uppercase tracking-wider text-slate-heading mb-1.5">
                    Seu Nome Completo *
                  </label>
                  <input 
                    type="text" 
                    id="nome" 
                    name="nome" 
                    required 
                    placeholder="Ex: João da Silva" 
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-brand-primary focus:ring-2 focus:ring-emerald-100 outline-none transition-all"
                  />
                </div>

                <div>
                  <label for="telefone" class="block text-xs font-bold uppercase tracking-wider text-slate-heading mb-1.5">
                    Telefone / WhatsApp *
                  </label>
                  <input 
                    type="tel" 
                    id="telefone" 
                    name="telefone" 
                    required 
                    placeholder="Ex: (47) 99999-9999" 
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-brand-primary focus:ring-2 focus:ring-emerald-100 outline-none transition-all"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="cidade" class="block text-xs font-bold uppercase tracking-wider text-slate-heading mb-1.5">
                    Cidade / Município do Imóvel *
                  </label>
                  <input 
                    type="text" 
                    id="cidade" 
                    name="cidade" 
                    required 
                    placeholder="Ex: Rio Negrinho, São Bento, etc." 
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-brand-primary focus:ring-2 focus:ring-emerald-100 outline-none transition-all"
                  />
                </div>

                <div>
                  <label for="servico" class="block text-xs font-bold uppercase tracking-wider text-slate-heading mb-1.5">
                    Serviço Desejado *
                  </label>
                  <select 
                    id="servico" 
                    name="servico" 
                    required
                    class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-brand-primary focus:ring-2 focus:ring-emerald-100 outline-none transition-all bg-white"
                  >
                    <option value="">Selecione o serviço...</option>
                    <option value="Medição e Desmembramento">Medição e Desmembramento de Terreno</option>
                    <option value="Escritura / Usucapião / Retificação">Escritura, Usucapião ou Retificação</option>
                    <option value="Georreferenciamento INCRA / CAR">Georreferenciamento INCRA (SIGEF) & CAR</option>
                    <option value="Venda de Madeira em Tora (Pinus)">Compra de Madeira em Tora de Pinus</option>
                    <option value="Corte Florestal Terceirizado">Serviço de Corte Florestal Terceirizado</option>
                    <option value="Topografia para Obras">Topografia para Engenharia & Obras</option>
                    <option value="Outro assunto">Outro assunto / Dúvida geral</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="mensagem" class="block text-xs font-bold uppercase tracking-wider text-slate-heading mb-1.5">
                  Conte um pouco sobre a sua propriedade ou necessidade:
                </label>
                <textarea 
                  id="mensagem" 
                  name="mensagem" 
                  rows="4" 
                  placeholder="Ex: Tenho uma área rural de 5 alqueires que precisa ser dividida entre 3 herdeiros..."
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:border-brand-primary focus:ring-2 focus:ring-emerald-100 outline-none transition-all"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-4 px-6 rounded-xl bg-brand-primary hover:bg-brand-primaryHover text-white font-bold text-base shadow-lg hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 group"
              >
                <span>Enviar Solicitação via WhatsApp</span>
                <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
              </button>

              <p class="text-xs text-slate-muted text-center">
                Ao clicar, você será direcionado para o WhatsApp com todos os dados preenchidos para envio instantâneo.
              </p>
            </form>

            <script>
              const form = document.getElementById('contact-form') as HTMLFormElement;
              if (form) {
                form.addEventListener('submit', (e) => {
                  e.preventDefault();
                  const nome = (document.getElementById('nome') as HTMLInputElement).value;
                  const telefone = (document.getElementById('telefone') as HTMLInputElement).value;
                  const cidade = (document.getElementById('cidade') as HTMLInputElement).value;
                  const servico = (document.getElementById('servico') as HTMLSelectElement).value;
                  const mensagem = (document.getElementById('mensagem') as HTMLTextAreaElement).value;

                  const text = `Olá, meu nome é ${nome} (${telefone}). Gostaria de um orçamento para ${servico} em ${cidade}. Detalhes: ${mensagem}`;
                  const url = `https://wa.me/5547984388016?text=${encodeURIComponent(text)}`;
                  window.open(url, '_blank');
                });
              }
            </script>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Seção do Mapa Interativo com Rotas -->
  <section class="py-12 bg-white border-t border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <h3 class="text-2xl font-extrabold text-slate-heading">Localização da Sede</h3>
          <p class="text-sm text-slate-body">Rodovia BR-280, nº 586, Sala 05, Bela Vista, Rio Negrinho – SC</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://maps.google.com/?cid=3724089901413813526"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-brand-primary hover:bg-brand-primaryHover text-white text-xs font-bold shadow-sm transition-colors"
          >
            <ExternalLink class="w-3.5 h-3.5" />
            <span>Navegar no Google Maps</span>
          </a>
          <a
            href="https://waze.com/ul?ll=-26.257324,-49.52358&navigate=yes"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-heading text-xs font-bold transition-colors"
          >
            <ExternalLink class="w-3.5 h-3.5" />
            <span>Abrir no Waze</span>
          </a>
        </div>
      </div>

      <div class="w-full h-80 sm:h-96 rounded-3xl overflow-hidden border border-gray-200 shadow-md">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3575.253628312061!2d-49.5257687!3d-26.257324!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x94ddd1ee47ceea77%3A0x33ae8f550baf6d16!2sSC%20Topografia%20e%20Planejamento!5e0!3m2!1spt-BR!2sbr!4v1710420000000!5m2!1spt-BR!2sbr"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa de Localização SC Topografia Rio Negrinho"
        ></iframe>
      </div>
    </div>
  </section>
</Layout>
