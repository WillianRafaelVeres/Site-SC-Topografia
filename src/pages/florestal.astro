---
import Layout from '../layouts/Layout.astro';
import PartnershipHero from '../components/florestal/PartnershipHero.astro';
import PartnershipHowItWorks from '../components/florestal/PartnershipHowItWorks.astro';
import PartnershipAudience from '../components/florestal/PartnershipAudience.astro';
import PartnershipResponsibilities from '../components/florestal/PartnershipResponsibilities.astro';
import PartnershipModels from '../components/florestal/PartnershipModels.astro';
import PartnershipSimulator from '../components/florestal/PartnershipSimulator.astro';
import PartnershipFactors from '../components/florestal/PartnershipFactors.astro';
import PartnershipEvaluation from '../components/florestal/PartnershipEvaluation.astro';
import PartnershipFAQ from '../components/florestal/PartnershipFAQ.astro';
import ForestryOtherServices from '../components/florestal/ForestryOtherServices.astro';
---

<Layout
  title="Parceria Florestal SC com Pinus | SC Topografia"
  description="Avalie sua propriedade para a Parceria Florestal SC. A empresa assume a implantação e o manejo florestal previstos no projeto, com proposta personalizada de remuneração e participação no valor da madeira."
  image="/images/hero-fallback.webp"
>
  <!-- Parceria Florestal SC: interesse → conceito → operação → lógica econômica → simulação → avaliação -->
  <PartnershipHero />
  <PartnershipHowItWorks />
  <PartnershipAudience />
  <PartnershipResponsibilities />
  <PartnershipModels />
  <PartnershipSimulator />
  <PartnershipFactors />
  <PartnershipEvaluation />
  <PartnershipFAQ />

  <!-- Serviços florestais já existentes (secundários) -->
  <ForestryOtherServices />
</Layout>

<style is:global>
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
