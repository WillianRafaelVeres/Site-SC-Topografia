---
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'SC Topografia e Operações Florestais | Rio Negrinho - SC',
  description = 'Soluções completas em topografia, agrimensura, georreferenciamento INCRA e operações florestais com venda de madeira em tora no Planalto Norte de Santa Catarina.',
  image = '/images/hero-fallback.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.sctopografia.com.br');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SC Topografia e Planejamento",
  "legalName": "SC Topografia e Planejamento LTDA",
  "url": "https://www.sctopografia.com.br",
  "logo": "https://www.sctopografia.com.br/images/logo.png",
  "image": `https://www.sctopografia.com.br${image}`,
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rodovia BR-280, 586, Sala 05, Bela Vista",
    "addressLocality": "Rio Negrinho",
    "addressRegion": "SC",
    "postalCode": "89297-578",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.2415,
    "longitude": -49.5218
  },
  "telephone": "+55-47-3644-4235",
  "priceRange": "$$",
  "openingHours": "Mo-Fr 08:00-18:00"
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" 
      rel="stylesheet" 
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="topografia rio negrinho, georreferenciamento SC, medição de terrenos planalto norte, CAR INCRA, usucapião, desmembramento, venda de madeira pinus tora, corte florestal terceirizado" />
    <meta name="author" content="SC Topografia e Planejamento" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-body font-sans antialiased selection:bg-brand-primary selection:text-white">
    <TopBar />
    <Navbar />
    
    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloating />
  </body>
</html>

<style is:global>
  /* Suavização de rolagem e seleção de texto */
  html {
    scroll-behavior: smooth;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* Cor base para títulos com especificidade zero para não sobrescrever classes utilitárias como text-white */
  :where(h1, h2, h3, h4, h5, h6) {
    color: #1A202C;
  }
</style>
