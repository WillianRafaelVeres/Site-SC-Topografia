---
import TopBar from '../components/TopBar.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloating from '../components/WhatsAppFloating.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Parceria Florestal e Topografia Rural em SC e PR | SC Topografia',
  description = 'Avaliação de propriedades para parceria florestal, topografia rural, regularização fundiária, madeira e gestão de corte no Planalto Norte de SC e Sul do PR.',
  image = '/images/hero-fallback.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://www.sctopografia.com.br');

const schemaData = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "SC Topografia e Planejamento",
  "legalName": "SC Topografia e Planejamento LTDA",
  "url": "https://www.sctopografia.com.br",
  "logo": "https://www.sctopografia.com.br/images/logo.png",
  "image": `https://www.sctopografia.com.br${image}`,
  "description": description,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Rodovia BR-280, 586, Sala 05, Bela Vista",
    "addressLocality": "Rio Negrinho",
    "addressRegion": "SC",
    "postalCode": "89297-578",
    "addressCountry": "BR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -26.2415,
    "longitude": -49.5218
  },
  "priceRange": "$$",
  "openingHours": "Mo-Fr 07:15-18:00",
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Planalto Norte de Santa Catarina" },
    { "@type": "AdministrativeArea", "name": "Sul do Paraná" }
  ]
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <ViewTransitions fallback="animate" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap" 
      rel="stylesheet" 
    />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="topografia rio negrinho, georreferenciamento SC, medição de terrenos planalto norte, CAR INCRA, usucapião, desmembramento, venda de madeira pinus tora, corte florestal terceirizado" />
    <meta name="author" content="SC Topografia e Planejamento" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-slate-body font-sans antialiased selection:bg-brand-primary selection:text-white">
    <a href="#conteudo-principal" class="skip-link">Pular para o conteúdo</a>
    <TopBar />
    <Navbar />
    
    <main id="conteudo-principal" class="flex-grow" tabindex="-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloating />
  </body>
</html>

<style is:global>
  /* Suavização de rolagem e seleção de texto */
  html {
    scroll-behavior: smooth;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* Cor base para títulos com especificidade zero para não sobrescrever classes utilitárias como text-white */
  :where(h1, h2, h3, h4, h5, h6) {
    color: #1A202C;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    transform: translateY(-160%);
    border-radius: 9999px;
    background: #ffffff;
    color: #0B2912;
    padding: 0.75rem 1rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.2);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  :where(a, button, input, select, textarea, [tabindex]):focus-visible {
    outline: 3px solid #28A745;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }

  /* Sistema de movimento do site: entrada suave, cartões responsivos e páginas conectadas. */
  html.motion-enabled [data-scroll-reveal] {
    opacity: 0;
    transform: translate3d(0, 1.25rem, 0);
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--motion-delay, 0ms);
    will-change: opacity, transform;
  }

  html.motion-enabled [data-scroll-reveal].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
    will-change: auto;
  }

  [data-motion-card] {
    transition:
      opacity 560ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 320ms ease,
      border-color 320ms ease;
  }

  [data-motion-card] img {
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    [data-motion-card].is-visible:hover,
    [data-motion-card]:not([data-scroll-reveal]):hover {
      transform: translate3d(0, -0.25rem, 0);
      border-color: rgb(16 185 129 / 0.38);
      box-shadow: 0 20px 42px -26px rgb(11 41 18 / 0.42);
    }

    [data-motion-card]:hover img {
      transform: scale(1.025);
    }
  }

  @keyframes site-page-out {
    to {
      opacity: 0;
      transform: translate3d(0, -0.25rem, 0);
    }
  }

  @keyframes site-page-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.5rem, 0);
    }
  }

  ::view-transition-old(root) {
    animation: 160ms ease both site-page-out;
  }

  ::view-transition-new(root) {
    animation: 260ms cubic-bezier(0.22, 1, 0.36, 1) both site-page-in;
  }

  ::view-transition-group(site-navbar) {
    z-index: 60;
  }

  @media (prefers-reduced-motion: reduce) {
    html.motion-enabled [data-scroll-reveal],
    html.motion-enabled [data-scroll-reveal].is-visible,
    [data-motion-card] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.01ms;
    }
  }
</style>

<script>
  let revealObserver: IntersectionObserver | undefined;

  const setupScrollMotion = () => {
    revealObserver?.disconnect();

    const main = document.querySelector('main');
    if (!main) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sections = Array.from(main.querySelectorAll<HTMLElement>('section'));

    document.documentElement.classList.toggle('motion-enabled', !reducedMotion);

    sections.forEach((section, sectionIndex) => {
      if (sectionIndex === 0 || section.dataset.motion === 'none') return;

      const sectionShell = Array.from(section.children).find((child) =>
        child instanceof HTMLElement && !child.classList.contains('absolute')
      ) as HTMLElement | undefined;

      if (sectionShell) sectionShell.dataset.scrollReveal = '';

      const cards = Array.from(section.querySelectorAll<HTMLElement>('article, [data-motion-card]'));
      cards.forEach((card, cardIndex) => {
        card.dataset.motionCard = '';
        card.dataset.scrollReveal = '';
        card.style.setProperty('--motion-delay', `${Math.min(cardIndex, 5) * 70}ms`);
      });
    });

    const targets = Array.from(main.querySelectorAll<HTMLElement>('[data-scroll-reveal]'));

    if (reducedMotion || !('IntersectionObserver' in window)) {
      targets.forEach((target) => {
        target.classList.add('is-visible');
        target.style.setProperty('--motion-delay', '0ms');
      });
      return;
    }

    const revealTarget = (target: HTMLElement) => {
      target.classList.add('is-visible');
      revealObserver?.unobserve(target);

      const delay = Number.parseInt(target.style.getPropertyValue('--motion-delay'), 10) || 0;
      window.setTimeout(() => target.style.setProperty('--motion-delay', '0ms'), delay + 620);
    };

    revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        revealTarget(entry.target as HTMLElement);
      });
    }, {
      threshold: 0.08,
      rootMargin: '0px 0px -8% 0px',
    });

    targets.forEach((target) => {
      target.addEventListener('focusin', () => revealTarget(target), { once: true });
      revealObserver?.observe(target);
    });
  };

  document.addEventListener('astro:page-load', setupScrollMotion);
</script>
