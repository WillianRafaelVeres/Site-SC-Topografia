---
import { ArrowRight, FileCheck, Satellite, Sparkles, Users2 } from 'lucide-astro';

const steps = [
  {
    number: '01',
    title: 'Levantamento técnico no campo',
    icon: Satellite,
    description: 'A equipe analisa a propriedade e realiza os levantamentos necessários com equipamentos adequados ao serviço.',
    highlight: 'Limites e informações técnicas levantados para orientar o processo.',
  },
  {
    number: '02',
    title: 'Coleta de assinaturas',
    icon: Users2,
    description: 'Quando o processo exige anuência, apoiamos a identificação dos confrontantes e a coleta das assinaturas necessárias.',
    highlight: 'Menos etapas soltas para o proprietário administrar sozinho.',
  },
  {
    number: '03',
    title: 'Acompanhamento documental',
    icon: FileCheck,
    description: 'Preparamos plantas e memoriais e acompanhamos as exigências técnicas do cartório dentro do escopo contratado.',
    highlight: 'Um responsável técnico acompanhando o processo do campo à documentação.',
  },
];
---

<section class="py-20 lg:py-28 bg-brand-lightBg border-y border-gray-200/80 relative overflow-hidden">
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-emerald-500/5 blur-3xl pointer-events-none"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl mb-14">
      <div class="inline-flex items-center gap-2 text-brand-primary text-xs font-bold uppercase tracking-[0.18em] mb-4">
        <Sparkles class="w-4 h-4" />
        <span>Atendimento completo</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-slate-heading tracking-tight leading-tight mb-5">
        Do campo ao cartório, acompanhamento em cada etapa.
      </h2>
      <p class="text-base sm:text-lg text-slate-body leading-relaxed">
        O diferencial está em coordenar o trabalho técnico e documental, reduzindo o número de interlocutores e dando clareza sobre o andamento do processo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-7">
      {steps.map(({ number, title, icon: Icon, description, highlight }) => (
        <article class="bg-white rounded-2xl p-7 border border-gray-200 shadow-sm flex flex-col">
          <div class="flex items-center justify-between mb-7">
            <span class="text-4xl font-black text-gray-200">{number}</span>
            <span class="w-12 h-12 rounded-xl bg-emerald-50 text-brand-primary flex items-center justify-center">
              <Icon class="w-6 h-6" />
            </span>
          </div>
          <h3 class="text-xl font-extrabold text-slate-heading mb-3">{title}</h3>
          <p class="text-sm text-slate-body leading-relaxed mb-6">{description}</p>
          <p class="mt-auto pt-5 border-t border-gray-100 text-xs font-bold text-emerald-900 leading-relaxed">{highlight}</p>
        </article>
      ))}
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5 p-6 sm:p-7 rounded-2xl bg-brand-dark text-white">
      <div>
        <h3 class="text-xl font-bold text-white mb-1">Tem uma propriedade para medir ou regularizar?</h3>
        <p class="text-sm text-gray-300">Conte o que precisa organizar e a equipe indica o próximo passo.</p>
      </div>
      <a href="/topografia" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-brand-primary hover:bg-brand-primaryHover text-white font-bold text-sm transition-colors flex-shrink-0 group">
        <span>Conhecer o atendimento</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>
  </div>
</section>
