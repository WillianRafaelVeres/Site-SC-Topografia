---
import { ArrowRight, ShieldCheck, CheckCircle2 } from 'lucide-astro';
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center justify-center overflow-hidden -mt-16 sm:-mt-20 pt-20">
  <!-- Imagem de Fundo de Alta Definição -->
  <div class="absolute inset-0 -z-20">
    <img 
      src="/images/hero-fallback.webp" 
      alt="Paisagem e Topografia no Planalto Norte" 
      class="w-full h-full object-cover scale-105"
      loading="eager"
    />
  </div>

  <!-- Overlay de Contraste Escuro com degradê no topo para integrar com o menu cápsula -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/80 via-black/60 to-black/80 -z-10"></div>

  <!-- Conteúdo Central -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 text-center text-white relative z-10">
    
    <!-- Tag de Destaque -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-primary/80 backdrop-blur-md text-emerald-100 text-xs sm:text-sm font-semibold mb-6 border border-emerald-400/30 shadow-lg">
      <ShieldCheck class="w-4 h-4 text-emerald-300" />
      <span>Mais de 20 anos de autoridade</span>
    </div>

    <!-- Título Principal de Impacto -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight sm:leading-tight lg:leading-tight mb-6 drop-shadow-md">
      Precisão no campo, <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 to-green-400">
        tranquilidade no cartório.
      </span>
    </h1>

    <!-- Subtítulo Didático e Direto -->
    <p class="max-w-3xl mx-auto text-base sm:text-xl text-gray-200 leading-relaxed font-normal mb-10 drop-shadow">
      Topografia de alta precisão, regularização fundiária e operações florestais em Rio Negrinho e região. Cuidamos do levantamento até a aprovação definitiva da sua documentação.
    </p>

    <!-- Botões de Ação Direta -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-5">
      <a
        href="https://wa.me/5547984388016?text=Ol%C3%A1%2C%20gostaria%20de%20um%20or%C3%A7amento%20para%20meu%20im%C3%B3vel."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-brand-primary hover:bg-brand-primaryHover text-white text-base sm:text-lg font-bold shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 group"
      >
        <!-- Ícone WhatsApp -->
        <svg class="w-5 h-5 fill-current text-emerald-200 group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.678.15-.2.3-.777.978-.953 1.179-.176.2-.351.226-.652.075-.301-.15-1.272-.469-2.423-1.496-.896-.799-1.5-1.787-1.676-2.088-.176-.3-.019-.463.132-.613.136-.135.301-.35.451-.526.15-.175.2-.3.301-.501.1-.2.05-.375-.025-.526-.075-.15-.677-1.631-.928-2.234-.244-.588-.493-.509-.678-.518-.176-.009-.376-.01-.577-.01-.2 0-.526.075-.802.376-.276.3-1.053 1.028-1.053 2.507 0 1.479 1.078 2.908 1.228 3.109.15.2 2.122 3.24 5.141 4.544.718.31 1.279.495 1.716.634.721.23 1.378.198 1.897.12.578-.088 1.78-.727 2.031-1.43.25-.702.25-1.304.175-1.43-.075-.125-.276-.201-.577-.351zM12.04 21.75c-1.748 0-3.414-.458-4.88-1.259l-.35-.19-3.633.953.97-3.541-.226-.361a9.696 9.696 0 0 1-1.488-5.187C2.433 6.81 7.237 2.006 13.093 2.006c2.838 0 5.506 1.106 7.513 3.112a10.56 10.56 0 0 1 3.106 7.516c-.001 5.856-4.805 10.616-11.672 10.616z"/>
        </svg>
        <span>Solicitar Orçamento no WhatsApp</span>
        <ArrowRight class="w-5 h-5 group-hover:translate-x-1 transition-transform" />
      </a>

      <a
        href="#pilares"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full bg-white/15 hover:bg-white/25 backdrop-blur-md text-white text-base font-semibold border border-white/20 transition-all duration-200"
      >
        <span>Conheça Nossas Soluções</span>
      </a>
    </div>

    <!-- Destaques Rápidos de Credibilidade -->
    <div class="mt-14 pt-8 border-t border-white/15 grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
      <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-200">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
        <span>Normas INCRA / SIGEF</span>
      </div>
      <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-200">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
        <span>Emissão de ART no CREA</span>
      </div>
      <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-200">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
        <span>GPS RTK de alta precisão</span>
      </div>
      <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-200">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 flex-shrink-0" />
        <span>Todo o processo do cartório</span>
      </div>
    </div>

  </div>
</section>
