---
const partners = [
  { name: 'Berneck', file: '/images/parceiros/berneck.webp' },
  { name: 'Klabin', file: '/images/parceiros/klabin.webp' },
  { name: 'WEG', file: '/images/parceiros/weg.webp' },
  { name: 'Arauco', file: '/images/parceiros/arauco.webp' },
  { name: 'CVG', file: '/images/parceiros/cvg.webp' },
  { name: 'Dibrape', file: '/images/parceiros/dibrape.webp' },
  { name: 'Masisa', file: '/images/parceiros/masisa.webp' },
  { name: 'Nóbile', file: '/images/parceiros/nobile.webp' },
  { name: 'Mobasa', file: '/images/parceiros/mobasa.webp' },
  { name: 'Trapp', file: '/images/parceiros/trapp.webp' },
  { name: 'Katzer', file: '/images/parceiros/katzer.webp' },
  { name: 'Triângulo', file: '/images/parceiros/triangulo.webp' },
  { name: 'Renova', file: '/images/parceiros/renova.webp' },
  { name: 'G. Maiochi', file: '/images/parceiros/g-maiochi.webp' },
  { name: 'MD', file: '/images/parceiros/md.webp' },
  { name: 'Caftor', file: '/images/parceiros/caftor.webp' },
];
---

<section class="py-6 sm:py-7 bg-brand-lightBg border-y border-gray-200/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-3 sm:mb-4">
      <p class="text-xs uppercase tracking-widest text-slate-muted font-bold">
        Empresas, indústrias e produtores que confiam em nosso trabalho
      </p>
    </div>

    <!-- Carrossel Marquee Infinito Suave das 16 Logos -->
    <div class="relative w-full overflow-hidden mask-fade">
      <div class="flex items-center gap-12 sm:gap-16 py-1 animate-marquee whitespace-nowrap">
        {/* Primeiro loop */}
        {partners.map((p) => (
          <div class="inline-flex items-center justify-center px-2 py-1 flex-shrink-0 hover:scale-105 transition-transform duration-300">
            <img 
              src={p.file} 
              alt={p.name} 
              title={p.name}
              class="h-12 sm:h-14 md:h-16 lg:h-18 w-auto max-w-[160px] sm:max-w-[190px] md:max-w-[230px] object-contain transition-transform duration-300"
              loading="lazy"
            />
          </div>
        ))}

        {/* Segundo loop para efeito contínuo infinito */}
        {partners.map((p) => (
          <div class="inline-flex items-center justify-center px-2 py-1 flex-shrink-0 hover:scale-105 transition-transform duration-300">
            <img 
              src={p.file} 
              alt={p.name} 
              title={p.name}
              class="h-12 sm:h-14 md:h-16 lg:h-18 w-auto max-w-[160px] sm:max-w-[190px] md:max-w-[230px] object-contain transition-transform duration-300"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  /* Efeito de fade suave nas laterais */
  .mask-fade {
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }
</style>
