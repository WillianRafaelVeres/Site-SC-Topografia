---
const items = [
  { label: 'Como funciona', href: '#como-funciona' },
  { label: 'Modelos', href: '#modelos' },
  { label: 'Simulação', href: '#simulador' },
  { label: 'Avaliar propriedade', href: '#avaliacao' },
  { label: 'Dúvidas', href: '#perguntas' },
];
---

<nav class="sticky top-[5.4rem] sm:top-[6.25rem] z-40 bg-white/95 backdrop-blur border-y border-gray-200 shadow-sm" aria-label="Nesta página">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 overflow-x-auto scrollbar-none">
    <div class="flex items-center gap-1 min-w-max py-2.5">
      <span class="hidden sm:inline text-[11px] font-bold uppercase tracking-wider text-slate-muted mr-2">Nesta página</span>
      {items.map((item, index) => (
        <a
          href={item.href}
          class={`px-3.5 py-2 rounded-full text-xs font-bold transition-colors ${index === 3 ? 'bg-brand-primary text-white hover:bg-brand-primaryHover' : 'text-slate-heading hover:text-brand-primary hover:bg-emerald-50'}`}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</nav>
