---
import { Axe, FileText, Map, Trees, ArrowRight } from 'lucide-astro';

const services = [
  {
    title: 'Topografia rural',
    icon: Map,
    description: 'Medição, divisão, georreferenciamento e apoio técnico para propriedades rurais e portfólios de imóveis.',
    href: '/topografia',
    cta: 'Conhecer topografia rural',
  },
  {
    title: 'Regularização fundiária',
    icon: FileText,
    description: 'Plantas, memoriais, coleta de assinaturas e acompanhamento técnico do processo dentro do escopo contratado.',
    href: '/topografia#regularizacao',
    cta: 'Ver regularização',
  },
  {
    title: 'Madeira de Pinus em tora',
    icon: Trees,
    description: 'Atendimento a serrarias e indústrias interessadas em consultar lotes, volumes e disponibilidade.',
    href: '/florestal#servicos-florestais',
    cta: 'Consultar madeira',
  },
  {
    title: 'Gestão técnica de corte',
    icon: Axe,
    description: 'Planejamento e acompanhamento da operação florestal, com agrimensura aplicada ao talhão e às divisas.',
    href: '/florestal#servicos-florestais',
    cta: 'Ver gestão de corte',
  },
];
---

<section class="py-20 lg:py-24 bg-white border-t border-gray-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-5 mb-10">
      <div class="max-w-3xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-primary mb-3">Outras soluções</p>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-heading tracking-tight">Apoio técnico para diferentes momentos da propriedade.</h2>
      </div>
      <p class="max-w-md text-sm sm:text-base text-slate-body leading-relaxed">
        Fale com a equipe para entender qual caminho faz sentido para a sua área ou para o conjunto de imóveis da sua empresa.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-gray-200 border border-gray-200 rounded-[2rem] overflow-hidden">
      {services.map(({ title, icon: Icon, description, href, cta }) => (
        <article class="bg-brand-lightBg p-6 sm:p-7 min-h-[300px] flex flex-col group">
          <div class="w-12 h-12 rounded-2xl bg-white border border-gray-200 text-brand-primary flex items-center justify-center mb-7 shadow-sm">
            <Icon class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-extrabold text-slate-heading mb-3">{title}</h3>
          <p class="text-sm text-slate-body leading-relaxed mb-7">{description}</p>
          <a href={href} class="mt-auto inline-flex items-center gap-2 text-sm font-bold text-brand-primary hover:text-brand-primaryHover group/link">
            <span>{cta}</span>
            <ArrowRight class="w-4 h-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
