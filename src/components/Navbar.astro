---
import { Menu, X, ArrowRight, MessageSquare } from 'lucide-astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Início', href: '/' },
  { name: 'Parceria Florestal', href: '/florestal' },
  { name: 'Topografia', href: '/topografia' },
  { name: 'Sobre Nós', href: '/sobre' },
  { name: 'Contato', href: '/contato' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  if (href.includes('#')) return false;
  return currentPath.startsWith(href.split('#')[0]);
};

const partnershipMessage = 'Olá! Gostaria de saber se minha propriedade tem potencial para uma parceria florestal.';
const topographyMessage = 'Olá! Preciso conversar sobre topografia ou regularização de uma propriedade rural.';
const generalMessage = 'Olá! Gostaria de conversar com a equipe da SC Topografia.';

const isPartnershipPage = currentPath === '/' || currentPath.startsWith('/florestal');
const isTopographyPage = currentPath.startsWith('/topografia');
const primaryCta = isPartnershipPage
  ? { desktop: 'Avaliar propriedade', mobile: 'Avaliar área', message: partnershipMessage }
  : isTopographyPage
    ? { desktop: 'Falar com a equipe técnica', mobile: 'Falar com técnico', message: topographyMessage }
    : { desktop: 'Iniciar conversa', mobile: 'WhatsApp', message: generalMessage };

const whatsappHref = `https://wa.me/5547984388016?text=${encodeURIComponent(primaryCta.message)}`;
---

<div class="sticky top-3 sm:top-4 z-50 w-full px-3 sm:px-6 pointer-events-none flex justify-center">
  <header
    id="pill-navbar"
    class="site-navbar pointer-events-auto w-full max-w-7xl rounded-full bg-white/90 backdrop-blur-md border border-white/40 shadow-lg px-4 sm:px-6 py-2.5 flex items-center justify-between"
    style="view-transition-name: site-navbar"
  >
    <a href="/" class="flex items-center gap-3 group py-1 flex-shrink-0" aria-label="SC Topografia — página inicial">
      <img
        id="navbar-logo"
        src="/images/logo.png"
        alt="SC Topografia"
        class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105"
        loading="eager"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1" aria-label="Navegação principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-item relative isolate px-2.5 xl:px-3 py-1.5 rounded-full text-[11px] xl:text-xs font-semibold transition-colors duration-200 ${
            isActive(link.href)
              ? 'text-brand-primary font-bold'
              : 'text-slate-heading hover:text-brand-primary hover:bg-black/5'
          }`}
        >
          {isActive(link.href) && (
            <span transition:name="nav-active" class="absolute inset-0 -z-10 rounded-full bg-emerald-100/70" aria-hidden="true"></span>
          )}
          <span>{link.name}</span>
        </a>
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-2">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-primary hover:bg-brand-primaryHover text-white text-xs font-bold shadow-md hover:shadow-lg transition-all group"
      >
        <MessageSquare class="w-3.5 h-3.5 text-emerald-200 group-hover:rotate-12 transition-transform" />
        <span>{primaryCta.desktop}</span>
        <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
      </a>
    </div>

    <div class="flex lg:hidden items-center gap-2">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3 py-1.5 rounded-full bg-brand-primary text-white text-xs font-bold flex items-center gap-1 shadow-sm"
      >
        <MessageSquare class="w-3.5 h-3.5" />
        <span>{primaryCta.mobile}</span>
      </a>

      <button
        id="mobile-menu-button"
        type="button"
        class="p-2 rounded-full text-slate-heading hover:text-brand-primary hover:bg-black/5 transition-colors focus:outline-none"
        aria-label="Abrir menu de navegação"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Menu id="icon-menu" class="w-5 h-5 block" />
        <X id="icon-close" class="w-5 h-5 hidden" />
      </button>
    </div>
  </header>
</div>

<div class="fixed top-20 inset-x-4 sm:inset-x-8 z-50 pointer-events-none flex justify-center">
  <div
    id="mobile-menu"
    class="hidden pointer-events-auto w-full max-w-md rounded-3xl bg-white/95 backdrop-blur-xl border border-gray-200/80 shadow-2xl p-5 animate-in fade-in slide-in-from-top-4 duration-200"
  >
    <nav class="space-y-2" aria-label="Navegação móvel">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-4 py-3 rounded-2xl text-sm font-semibold transition-colors ${
            isActive(link.href)
              ? 'text-brand-primary bg-emerald-50 font-bold'
              : 'text-slate-heading hover:text-brand-primary hover:bg-gray-50'
          }`}
        >
          {link.name}
        </a>
      ))}

      <div class="pt-4 border-t border-gray-100">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full flex items-center justify-center gap-2 px-5 py-3 rounded-2xl bg-brand-primary hover:bg-brand-primaryHover text-white text-sm font-bold shadow-md transition-colors"
        >
          <MessageSquare class="w-4 h-4 text-emerald-200" />
          <span>{primaryCta.desktop}</span>
        </a>
      </div>
    </nav>
  </div>
</div>

<script>
  let cleanupNavbar: (() => void) | undefined;

  const setupNavbar = () => {
    cleanupNavbar?.();

    const nav = document.getElementById('pill-navbar');
    const btn = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const iconMenu = document.getElementById('icon-menu');
    const iconClose = document.getElementById('icon-close');

    if (!nav || !btn || !menu || !iconMenu || !iconClose) return;

    const closeMenu = () => {
      menu.classList.add('hidden');
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menu de navegação');
    };

    const toggleMenu = () => {
      const willOpen = menu.classList.contains('hidden');
      if (willOpen) {
        menu.classList.remove('hidden');
        iconMenu.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Fechar menu de navegação');
      } else {
        closeMenu();
      }
    };

    const updateNavbar = () => {
      nav.toggleAttribute('data-scrolled', window.scrollY > 36);
    };

    const closeOnEscape = (event: KeyboardEvent) => {
      if (event.key === 'Escape') closeMenu();
    };

    const closeOnOutsideClick = (event: MouseEvent) => {
      const target = event.target;
      if (!(target instanceof Node) || menu.classList.contains('hidden')) return;
      if (!menu.contains(target) && !btn.contains(target)) closeMenu();
    };

    btn.addEventListener('click', toggleMenu);
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    window.addEventListener('scroll', updateNavbar, { passive: true });
    document.addEventListener('keydown', closeOnEscape);
    document.addEventListener('click', closeOnOutsideClick);
    updateNavbar();

    cleanupNavbar = () => {
      btn.removeEventListener('click', toggleMenu);
      window.removeEventListener('scroll', updateNavbar);
      document.removeEventListener('keydown', closeOnEscape);
      document.removeEventListener('click', closeOnOutsideClick);
    };
  };

  document.addEventListener('astro:page-load', setupNavbar);
</script>

<style>
  .site-navbar {
    transition:
      max-width 360ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 360ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 260ms ease,
      border-color 260ms ease,
      box-shadow 260ms ease;
  }

  .site-navbar :global(#navbar-logo) {
    transition: height 360ms cubic-bezier(0.22, 1, 0.36, 1), transform 220ms ease;
  }

  .site-navbar[data-scrolled] {
    max-width: 72rem;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    background-color: rgb(255 255 255 / 0.96);
    border-color: rgb(229 231 235 / 0.92);
    box-shadow: 0 14px 35px -20px rgb(11 41 18 / 0.45);
  }

  .site-navbar[data-scrolled] :global(#navbar-logo) {
    height: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-navbar,
    .site-navbar :global(#navbar-logo) {
      transition: none;
    }
  }
</style>
